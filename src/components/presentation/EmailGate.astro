<div id='email-gate' hidden class="fixed inset-0 z-[999] grid place-items-center [background:#12273e99] [backdrop-filter:blur(5px)] p-[20px]">
	<form id='email-gate-form' class="w-full max-w-[380px] bg-paper text-ink rounded-[12px] border border-solid border-line p-[28px] [box-shadow:0_30px_100px_#0e233b40]">
		<h2 class="text-[22px] tracking-[-0.5px] mb-[10px]">Antes de arrancar</h2>
		<p class="text-[13px] text-muted mb-[20px]">Dejanos tu email. Lo vamos a usar para tu autoevaluación al final del curso.</p>
		<label for='email-gate-input' class="sr-only">Email</label>
		<input id='email-gate-input' type='email' required autocomplete='email' placeholder='tu@email.com' class="w-full text-[14px] py-[11px] px-[14px] rounded-[8px] border border-solid border-line mb-[16px] [background:white]" />
		<button type='submit' class="w-full text-[14px] font-medium text-[white] bg-ink py-[11px] px-0 rounded-[8px] border-[0]">Continuar</button>
	</form>
</div>
